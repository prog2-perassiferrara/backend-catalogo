# Variables compartidas por Compose y el backend ejecutado desde el IDE.
DB_NAME=catalog
DB_USER=catalog
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306
APP_PORT=8080
# Solo inicializa MySQL; no se entrega al backend.
MYSQL_ROOT_PASSWORD=
# Cuenta técnica registrada manualmente y groupId normalizado asignado por cátedra.
CATEDRA_BASE_URL=
CATEDRA_USERNAME=
CATEDRA_PASSWORD=
CATEDRA_GROUP_ID=
# Ruta a la pública PEM de Turnos en el host; nunca configurar su privada en Catálogo.
JWT_PUBLIC_KEY_PATH=
# Opcional: orígenes web separados por comas, sin comodines ni rutas. Vacío para Android nativo.
CORS_ALLOWED_ORIGINS=
