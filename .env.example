# Variables compartidas por Compose y el backend ejecutado desde el IDE.
DB_NAME=catalog
DB_USER=catalog
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306
APP_PORT=8080
# Solo inicializa MySQL; no se entrega al backend.
MYSQL_ROOT_PASSWORD=
# Cuenta técnica registrada manualmente y groupId normalizado asignado por cátedra.
CATEDRA_BASE_URL=
CATEDRA_USERNAME=
CATEDRA_PASSWORD=
CATEDRA_GROUP_ID=
# Ruta a la pública PEM de Turnos en el host; nunca configurar su privada en Catálogo.
JWT_PUBLIC_KEY_PATH=
# Opcional: orígenes web separados por comas, sin comodines ni rutas. Vacío para Android nativo.
CORS_ALLOWED_ORIGINS=

# Opcionales: descomentar solo las sobrescrituras necesarias. Tiempos en milisegundos.
# CATALOG_INTEGRATION_MAX_ATTEMPTS=3
# CATALOG_INTEGRATION_RETRY_DELAY_MS=5000
# CATALOG_INTEGRATION_CONNECT_TIMEOUT_MS=5000
# CATALOG_INTEGRATION_READ_TIMEOUT_MS=5000
# CATALOG_INTEGRATION_REQUEST_TIMEOUT_MS=10000
# CATALOG_SNAPSHOT_MAX_ATTEMPTS=3
# CATALOG_SNAPSHOT_RETRY_DELAY_MS=5000
# CATALOG_SNAPSHOT_CONNECT_TIMEOUT_MS=5000
# CATALOG_SNAPSHOT_READ_TIMEOUT_MS=10000
# CATALOG_SNAPSHOT_REQUEST_TIMEOUT_MS=20000
# CATALOG_INCREMENTAL_MAX_ATTEMPTS=3
# CATALOG_INCREMENTAL_RETRY_DELAY_MS=5000
# CATALOG_INCREMENTAL_RETRY_COOLDOWN_MS=30000
# CATALOG_RECOVERY_MAX_CYCLES=3
# CATALOG_RECOVERY_CYCLE_DELAY_MS=30000
# CATALOG_RECOVERY_BLOCK_DELAY_MS=300000
# CATALOG_REDIS_CONNECT_TIMEOUT_MS=5000
# CATALOG_REDIS_COMMAND_TIMEOUT_MS=5000
# CATALOG_REDIS_READ_TIMEOUT_MS=20000
# CATALOG_KAFKA_TIMEOUT_MS=10000
# CATALOG_MONITOR_INTERVAL_MS=30000
